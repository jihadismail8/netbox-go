# Need to package the code first `tar zcf netbox_go.tar.gz $(ls)` and move it to the same directory as Dokerfile
# rpc server source code, used to test rpc methods
FROM golang:1.26-alpine
MAINTAINER zhufuyi "g.zhufuyi@gmail.com"

# go test dependency packages
RUN apk add bash alpine-sdk build-base gcc

COPY . /go/src/netbox_go
WORKDIR /go/src/netbox_go
RUN tar zxf netbox_go.tar.gz
RUN go env -w GOPROXY=https://goproxy.cn,direct
RUN go mod download
RUN rm -f netbox_go.tar.gz

CMD ["sleep","86400"]
