{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netbox-go.local/schemas/capability-profile-v1.json",
  "title": "NetBox Go capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "compatibility_baseline",
    "contract_state",
    "owners",
    "interfaces",
    "operations",
    "resources",
    "identity_extension",
    "resource_metadata",
    "traceability",
    "scenarios",
    "required_evidence",
    "deferred"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "compatibility_baseline": { "const": "netbox-v4.4.6-post7" },
    "contract_state": { "enum": ["pre-publication", "frozen"] },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": { "type": "object", "required": ["rest", "grpc", "vue"] },
    "operations": {
      "type": "array",
      "const": ["list", "get", "create", "replace", "update", "delete"]
    },
    "bulk_operations": { "const": false },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "name",
          "rest_path",
          "grpc_service",
          "grpc_prefix",
          "tier",
          "owner"
        ],
        "properties": {
          "module": { "enum": ["dcim", "ipam"] },
          "name": { "type": "string", "minLength": 1 },
          "rest_path": {
            "type": "string",
            "pattern": "^/api/(dcim|ipam)/.+/$"
          },
          "grpc_service": {
            "type": "string",
            "pattern": "^netbox\\.(dcim|ipam)\\.v1\\.[A-Za-z]+$"
          },
          "grpc_prefix": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
          "owner": { "type": "string", "minLength": 1 },
          "extra_rpcs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "identity_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_metadata",
        "classification",
        "tier",
        "owner",
        "verification"
      ],
      "properties": {
        "resource_metadata": {
          "type": "string",
          "pattern": "^\\.\\./resources/identity\\.yaml$"
        },
        "classification": { "const": "extension" },
        "tier": { "const": "not_applicable" },
        "owner": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "parity", "security"],
          "properties": {
            "contract": { "enum": ["partial", "complete"] },
            "parity": { "enum": ["partial", "complete"] },
            "security": { "enum": ["partial", "complete"] }
          }
        }
      }
    },
    "resource_metadata": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "traceability": {
      "type": "string",
      "pattern": "^\\.\\./traceability/[a-z][a-z0-9-]+\\.yaml$"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "deferred": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
