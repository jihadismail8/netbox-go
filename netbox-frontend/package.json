{
  "name": "netbox-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "glob": "13.0.6"
  },
  "scripts": {
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "dev": "vite",
    "build": "npm run typecheck && npm run build:only",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run toolchain:check && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:test && npm run test:coverage && npm run build:only",
    "quality": "npm run check"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "24.10.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "3.2.7",
    "vue-tsc": "^3.3.5"
  }
}
