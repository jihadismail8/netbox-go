# Repository-local pinned tool binaries and caches.
/.tools/
/.agents/
/.codex/

# Frontend dependencies and generated output.
/netbox-frontend/node_modules/
/netbox-frontend/dist/
/netbox-frontend/coverage/

# Backend build and test output.
/netbox-backend/netbox_go
/netbox-backend/cover.out
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Deployment and compatibility run artifacts.
/tests/deployment/.artifacts/

# Local environment and credential files. Checked-in examples remain allowed.
.env
.env.*
!.env.example
!.env.*.example

# Go workspace files are developer-local for this multi-module tree.
go.work
go.work.sum

# Python caches created while running the pinned NetBox oracle tooling.
__pycache__/
*.py[cod]
.pytest_cache/

# Logs, temporary files, and editor/OS metadata.
*.log
*.tmp
*.swp
*~
.DS_Store
/.idea/
/.vscode/
